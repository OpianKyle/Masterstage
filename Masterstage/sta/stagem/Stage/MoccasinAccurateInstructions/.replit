modules = ["nodejs-24"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Stage Master Site"

[[workflows.workflow]]
name = "Stage Master Site"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Stage-Master && PORT=5000 BASE_PATH=/ pnpm --filter @workspace/stage-master run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 26217
externalPort = 3001

[deployment]
deploymentTarget = "static"
build = ["bash", "-c", "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/stage-master run build"]
publicDir = "artifacts/stage-master/dist/public"
